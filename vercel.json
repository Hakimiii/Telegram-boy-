{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/telegram/webhook",
      "destination": "/api/telegram/webhook"
    },
    {
      "source": "/api/bot/status",
      "destination": "/api/bot/status"
    },
    {
      "source": "/api/ping",
      "destination": "/api/ping"
    },
    {
      "source": "/api/config",
      "destination": "/api/config"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
